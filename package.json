{
  "name": "csm-chat",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Assisted Customer Success Chat — Phase 1 MVP",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @csm-chat/db db:generate",
    "db:migrate": "pnpm --filter @csm-chat/db db:migrate",
    "db:seed": "pnpm --filter @csm-chat/db db:seed",
    "db:studio": "pnpm --filter @csm-chat/db db:studio",
    "db:verify": "pnpm --filter @csm-chat/db db:verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.10",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild"
    ]
  }
}
